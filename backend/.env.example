# Use Neon's pooled connection string for normal API traffic.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Optional: use Neon's direct (non-pooler) connection string when importing/migrating.
# MIGRATION_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Generate a unique random value with at least 32 characters.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
